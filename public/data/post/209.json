{"id":209,"date":"2026-08-24T15:16:22","date_gmt":"2026-08-24T15:16:22","guid":{"rendered":"https://backend.ddev.site/?p=209"},"modified":"2026-08-26T16:41:48","modified_gmt":"2026-08-26T16:41:48","slug":"bts-develpoment-pl","status":"publish","type":"post","link":"https://backend.ddev.site/bts-develpoment-pl/","title":{"rendered":"Bts-develpoment.pl"},"content":{"rendered":"\n<p class=\"wp-block-paragraph\">Strona dla BTS-Development, polskiego dewelopera nieruchomości komercyjnych, który specjalizuje się w projektowaniu, budowie oraz długoterminowym wynajmie nowoczesnych hal magazynowych, produkcyjnych, logistycznych oraz usługowych. Instalacja WordPress.</p>\n\n\n\n<h3 class=\"wp-block-heading\">Zakres obowiązków:</h3>\n\n\n\n<ul class=\"wp-block-list\">\n<li>przygotowanie struktury html komponentów w builderze Bricks</li>\n\n\n\n<li>stworzenie arkuszy stylów w oparciu o istniejący design</li>\n\n\n\n<li>zaprojektowanie i realizacja logiki skryptów odpowiadających za szatę wizualną</li>\n\n\n\n<li>zadbanie o jakość interfejsu na urządzeniach mobilnych</li>\n\n\n\n<li>regularne aktualizacje</li>\n</ul>\n","protected":false},"excerpt":{"rendered":"<p>Strona dla BTS-Development, polskiego dewelopera nieruchomości komercyjnych, który specjalizuje się w projektowaniu, budowie oraz długoterminowym wynajmie nowoczesnych hal magazynowych, produkcyjnych, logistycznych oraz usługowych. Instalacja WordPress. Zakres obowiązków:</p>\n","protected":false},"author":1,"featured_media":0,"comment_status":"open","ping_status":"open","sticky":false,"template":"","format":"standard","meta":{"_acf_changed":false,"footnotes":""},"categories":[3],"tags":[],"class_list":["post-209","post","type-post","status-publish","format-standard","hentry","category-pl"],"acf":{"template":"","lang":"pl","order":"70","link":"https://bts-development.pl/","photo_1":"/files/Zrzut-ekranu-2026-08-24-171443.png","photo_2":"/files/Zrzut-ekranu-2026-08-24-171449.png","photo_3":"/files/Zrzut-ekranu-2026-08-24